#!/bin/sh

export RELEASE_DISTRIBUTION="name"

# Uncomment to send crash dumps to stderr
# This can be useful for debugging, but may log sensitive information
# export ERL_CRASH_DUMP=/dev/stderr
# export ERL_CRASH_DUMP_BYTES=4096

# A single, non-clustered instance: name the node on the loopback address,
# so `bin/<%= @release.name %> remote` works inside any container (a container's
# hostname isn't fully qualified, which long names need). Set RELEASE_NODE
# to cluster.
export RELEASE_NODE=${RELEASE_NODE:-<%= @release.name %>@127.0.0.1}
