<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <meta name="description" content={site_description()} />
    <meta name="theme-color" content="#1d1f21" />
    <.live_title
      default="guiltty · a GPU-accelerated terminal emulator in Elixir and C"
      phx-no-format
    >{assigns[:page_title]}</.live_title>
    <link rel="canonical" href={canonical_url(assigns[:conn])} />
    <%!-- Link previews (LinkedIn, Slack, Discord, X, …) --%>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="guiltty" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonical_url(assigns[:conn])} />
    <meta
      property="og:title"
      content={
        assigns[:page_title] || "guiltty · a GPU-accelerated terminal emulator in Elixir and C"
      }
    />
    <meta property="og:description" content={site_description()} />
    <meta property="og:image" content={site_url() <> "/images/og-image.png"} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="The guiltty logo beside the words: GPU-accelerated Linux terminal, Elixir + C, Vulkan, self-healing tabs"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href={~p"/images/favicon.svg"} />
    <link rel="icon" href={~p"/favicon.ico"} sizes="any" />
    <link rel="apple-touch-icon" href={~p"/images/apple-touch-icon.png"} />
    <script type="application/ld+json">
      <%= Phoenix.HTML.raw(structured_data()) %>
    </script>
    <link
      rel="preload"
      href={~p"/fonts/roboto-flex/roboto-flex-latin-opsz-normal.woff2"}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={~p"/fonts/jetbrains-mono/jetbrains-mono-latin-wght-normal.woff2"}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
    <%!-- No data-theme by default: the page follows the OS, which is
          PhoenixPaper.ThemeToggle's "System" (it removes the attribute;
          daisyUI's `prefersdark` theme follows the same media query). A
          Light/Dark choice is saved under "phx:theme"; restore it before
          first paint so there's no flash. --%>
    <script>
      (() => {
        const theme = localStorage.getItem("phx:theme");
        if (theme) document.documentElement.setAttribute("data-theme", theme);
      })();
    </script>
  </head>
  <body class="bg-pp-surface text-pp-on-surface antialiased">
    {@inner_content}
  </body>
</html>
